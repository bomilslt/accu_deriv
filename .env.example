# .env - Variables d'environnement pour le bot Deriv (nouvelle API)
# Copiez ce fichier en .env et remplissez vos identifiants

# App ID de votre application créée sur https://developers.deriv.com
# (nouvelle interface: identifiant ALPHANUMÉRIQUE, ex: 347SF2XS6xaQFLMJfT0k0)
DERIV_APP_ID=votre_app_id_ici

# Personal Access Token (PAT) au format pat_...
# ⚠️ Généré sur la nouvelle interface Deriv (droits lecture + trading)
# ⚠️ Le token n'est affiché QU'UNE SEULE FOIS à sa création: copiez-le ENTIÈREMENT
# ⚠️ Ne partagez jamais ce fichier avec votre token réel
DERIV_TOKEN=pat_votre_token_ici

# --- Paramètres de trading (optionnels, sinon valeurs de config.py) ---
# Type de compte: "demo" (recommandé pour tester) ou "real"
DERIV_ACCOUNT_TYPE=demo

# Marché/symbole (R_10, R_25, R_50, R_75, R_100...)
DERIV_SYMBOL=R_100

# Mise par trade en USD
DERIV_STAKE=10
