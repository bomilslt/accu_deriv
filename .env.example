# .env - Variables d'environnement pour le bot Deriv
# Copiez ce fichier en .env et remplissez vos identifiants

# App ID de votre application Deriv (1089 est l'ID public par défaut)
DERIV_APP_ID=1089

# Votre token API personnel (à générer sur https://app.deriv.com/account/api-token)
# ⚠️ Ne partagez jamais ce fichier avec votre token réel
DERIV_TOKEN=votre_token_ici
